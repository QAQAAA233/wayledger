{
  "name": "wayledger",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "TRIP", "class_name": "TripDO" },
      { "name": "QUOTA", "class_name": "Quota" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripDO", "Quota"] }],
  "vars": { "PAYPAL_BASE": "https://api-m.sandbox.paypal.com", "AI_PER_IP_HOUR": "15", "AI_PER_DAY": "400" }
}
